# TrueNAS SCALE "Custom App → Install via YAML" template.
#
# Rendered automatically by ./scripts/setup.sh into
# truenas-custom-app.rendered.yaml (gitignored, contains your real
# domains/hash) — you shouldn't need to touch this file directly. It's
# separate from docker-compose.yml because TrueNAS's Custom App installer
# doesn't read .env and wants absolute host paths, not the `./config/...`
# relative ones docker-compose.yml uses. It also has reported issues with
# the compose-level `secrets:`/`profiles:` constructs, so the optional
# Authelia/2FA service (README §9) isn't included here — deploy that piece
# over SSH with the regular docker-compose.yml instead.
#
# To deploy the rendered file: Apps → Discover Apps → Custom App →
# Install via YAML, paste in the contents of
# truenas-custom-app.rendered.yaml.

services:
  headscale:
    image: headscale/headscale:0.29.3@sha256:0e7f1c6e4ce6c2a2a001103ecd3fa645a045adf30ac8a5234fe037b43000cd72
    container_name: headscale
    restart: unless-stopped
    command: headscale serve
    volumes:
      - __REPO_DIR__/config/headscale:/etc/headscale:ro
      - __REPO_DIR__/data/headscale:/var/lib/headscale
    networks:
      - headscale
    environment:
      - TZ=__TZ__
      - HEADSCALE_SERVER_URL=https://__HEADSCALE_DOMAIN__
    expose:
      - "8080"
    security_opt:
      - no-new-privileges:true
    cap_drop:
      - ALL
    read_only: true
    tmpfs:
      - /var/run/headscale:mode=0770
      - /tmp
    mem_limit: 512m
    pids_limit: 200
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"

  headscale-admin:
    image: goodieshq/headscale-admin:v0.27.0@sha256:e579fce717aa9b52d8a4a17e7624ef8e2f0352b90da333615ffd1eccd9e34bf5
    container_name: headscale-admin
    restart: unless-stopped
    networks:
      - headscale
    expose:
      - "80"
    security_opt:
      - no-new-privileges:true
    cap_drop:
      - ALL
    cap_add:
      - NET_BIND_SERVICE
      - CHOWN
      - SETUID
      - SETGID
      - DAC_OVERRIDE
    mem_limit: 128m
    pids_limit: 100
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"

  caddy:
    image: caddy:2.10-alpine@sha256:4c6e91c6ed0e2fa03efd5b44747b625fec79bc9cd06ac5235a779726618e530d
    container_name: headscale-caddy
    restart: unless-stopped
    depends_on:
      - headscale
      - headscale-admin
    volumes:
      - __REPO_DIR__/config/caddy:/etc/caddy:ro
      - __REPO_DIR__/data/caddy/data:/data
      - __REPO_DIR__/data/caddy/config:/config
    networks:
      - headscale
    ports:
      - "__HOST_HTTP_PORT__:80"
      - "__HOST_HTTPS_PORT__:443"
      - "__HOST_HTTPS_PORT__:443/udp"
    environment:
      - HEADSCALE_DOMAIN=__HEADSCALE_DOMAIN__
      - HEADSCALE_ADMIN_DOMAIN=__HEADSCALE_ADMIN_DOMAIN__
      # Leave as-is unless you're also setting up 2FA over SSH later —
      # harmless if unused, since Caddy's conf.d/sites import is a no-op
      # until a site block actually exists there (see README §9).
      - AUTHELIA_DOMAIN=
      - ACME_EMAIL=__ACME_EMAIL__
      - ADMIN_ALLOWED_CIDRS=__ADMIN_ALLOWED_CIDRS__
      - ADMIN_BASIC_AUTH_USER=__ADMIN_BASIC_AUTH_USER__
      - ADMIN_BASIC_AUTH_HASH=__ADMIN_BASIC_AUTH_HASH__
      - ADMIN_AUTH_SNIPPET=basic_auth_gate
    security_opt:
      - no-new-privileges:true
    cap_drop:
      - ALL
    cap_add:
      - NET_BIND_SERVICE
    read_only: true
    tmpfs:
      - /tmp
    mem_limit: 256m
    pids_limit: 100
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"

networks:
  headscale:
    name: headscale
