# Copy this file to .env and fill in your values.
# .env is gitignored so real secrets/domains never get committed.

# The domain (or subdomain) that will point at this Headscale server,
# e.g. headscale.example.com
HEADSCALE_DOMAIN=headscale.example.com

# Subdomain for the headscale-admin web UI. Must be a *different* hostname
# than HEADSCALE_DOMAIN above (both point at the same TrueNAS box, just
# different names), e.g. headscale-admin.example.com
HEADSCALE_ADMIN_DOMAIN=headscale-admin.example.com

# Email used for Let's Encrypt certificate registration/renewal notices
ACME_EMAIL=you@example.com

# Host timezone (affects logs/backups)
TZ=UTC
