{
	email {$ACME_EMAIL}
}

# Shared response hardening for all sites.
(hardening) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		Permissions-Policy "geolocation=(), microphone=(), camera=()"
		-Server
	}
}

# Default auth gate for headscale-admin: username/password only. Selected
# via ADMIN_AUTH_SNIPPET in .env (defaults to this one).
(basic_auth_gate) {
	basic_auth {
		{$ADMIN_BASIC_AUTH_USER} {$ADMIN_BASIC_AUTH_HASH}
	}
}

# Optional stronger auth gate: username/password + TOTP via Authelia.
# Requires the "2fa" compose profile to be running — see README "Optional:
# two-factor authentication" before setting ADMIN_AUTH_SNIPPET to this.
(forward_auth_gate) {
	forward_auth authelia:9091 {
		uri /api/authz/forward-auth
		copy_headers Remote-User Remote-Groups Remote-Email Remote-Name
	}
}

{$HEADSCALE_DOMAIN} {
	import hardening

	reverse_proxy headscale:8080

	encode zstd gzip

	log {
		output stdout
		format console
	}
}

# headscale-admin (web UI). Its own calls to the headscale API are proxied
# same-origin under /api/* here — point headscale-admin's Settings page at
# this domain (https://{$HEADSCALE_ADMIN_DOMAIN}), not the main headscale
# domain, so the browser never has to make a cross-origin request.
#
# This UI holds a bearer key that can fully administer the tailnet (create
# users, mint pre-auth keys, delete nodes — there is no read-only headscale
# key), and its hostname is public the moment Let's Encrypt issues a cert
# for it (Certificate Transparency logs), so it's locked down two ways:
# an IP allowlist (only your LAN and the tailnet itself may connect) and
# an auth gate on top of that — username/password by default, or
# username/password + TOTP if you've enabled the "2fa" profile (see README).
{$HEADSCALE_ADMIN_DOMAIN} {
	import hardening

	@not_allowed not remote_ip {$ADMIN_ALLOWED_CIDRS}
	abort @not_allowed

	import {$ADMIN_AUTH_SNIPPET:basic_auth_gate}

	header {
		X-Frame-Options "DENY"
		X-Robots-Tag "noindex, nofollow, noarchive"
		Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'"
	}

	handle /api/* {
		reverse_proxy headscale:8080
	}

	handle {
		reverse_proxy headscale-admin:80
	}

	encode zstd gzip

	log {
		output stdout
		format console
	}
}

